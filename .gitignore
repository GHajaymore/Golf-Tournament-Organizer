# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
# Any alternate build dir (NEXT_DIST_DIR) — artifacts never belong in a public repo.
/.next*/
/out/
next-env.d.ts

# production
/build

# electron-builder output
/release

# database
*.db
*.db-journal
/prisma/dev.db*

# env
.env
.env*.local

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# testing
/coverage

# editor
.vscode/*
!.vscode/extensions.json
.idea

# build info
tsconfig.tsbuildinfo

.vercel
.env*

# Throwaway QA scripts written during test passes — never part of the app.
.qa-*.mjs

# End-to-end runs: signed-in browser state (real session cookies), the
# fixture's ids, the separate build dir and Playwright's own output.
/.e2e
/.next-e2e
/test-results
/playwright-report

# The world-walk cursor: the importer's own bookkeeping, not app data.
.course-walk.json
