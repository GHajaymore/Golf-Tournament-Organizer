# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
# Any alternate build dir (NEXT_DIST_DIR) — artifacts never belong in a public repo.
/.next*/
/out/
next-env.d.ts

# production
/build

# electron-builder output
/release

# database
*.db
*.db-journal
/prisma/dev.db*

# env
.env
.env*.local

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# testing
/coverage

# editor
.vscode/*
!.vscode/extensions.json
.idea

# build info
tsconfig.tsbuildinfo

.vercel
.env*

# The main session's id, read by .claude/hooks/guard.mjs (only that session merges or
# pushes a round). Local to this machine and rewritten by each new main session.
/.claude/main-session

# Throwaway QA scripts written during test passes — never part of the app.
.qa-*.mjs

# End-to-end runs: signed-in browser state (real session cookies), the
# fixture's ids, the separate build dir and Playwright's own output.
/.e2e
/.qa
/.next-e2e
/test-results
/playwright-report

# The world-walk cursor: the importer's own bookkeeping, not app data.
.course-walk.json

# Mutation testing (npm run mutation): the report and the sandbox are made
# per run. reports/stryker-incremental.json is the incremental cache.
/reports/mutation/
/.stryker-tmp/
/reports/stryker-incremental.json
