# Copy to .env and fill in. Never commit the real .env — it's gitignored.

# Postgres connection string. Local dev and production should be separate
# databases (e.g. two Neon projects) so local testing never touches real
# tournament data.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Signs session cookies (HMAC) and password reset tokens are hashed
# independently of this. Generate a real random value for anything other
# than local dev — e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Signs the session and round-code cookies (HMAC-SHA256).
#
# THIS VALUE IS FOR LOCAL DEVELOPMENT ONLY. It is committed to a public
# repository, so anyone can read it. A deployment running on it can have an
# admin session forged by a stranger — this was a real finding, verified by
# minting a working cookie from the literal below.
#
# Generate a real one and set it in the host's environment settings:
#   node -e "console.log(require(\"crypto\").randomBytes(32).toString(\"base64url\"))"
#
# Changing it signs every existing session out. That is the intended effect.
AUTH_SECRET="dev-only-not-for-any-deployment"

# Password-reset emails via Resend (resend.com). Without this set, reset
# links are logged to the server console instead of emailed — fine for local
# dev, not for production.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="TourneyHQ <onboarding@resend.dev>"

# Plan billing via Stripe (stripe.com) — clubs paying TourneyHQ for the
# software, on Stripe's own hosted pages. Golf money (skins, prizes,
# settle-ups) never goes through this. Leave both empty and billing stays off:
# the plan panel says plans are arranged directly, exactly as before.
# Use test-mode keys (sk_test_…) anywhere but production. The webhook secret
# comes from the endpoint you add in Stripe for /api/stripe/webhook (or from
# `stripe listen` when testing locally).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Server error reports, sent to Sentry. Leave empty to switch reporting off —
# the SDK is not even loaded then. The DSN is in Sentry under Project settings
# → Client Keys. Reports are scrubbed of URL tokens and email addresses before
# they leave (src/lib/domain/error-report.ts).
SENTRY_DSN=""

# Cookie-free page counts (Vercel Web Analytics). Off unless exactly "on", and
# Web Analytics must also be enabled for the project in the Vercel dashboard.
# Build-time (NEXT_PUBLIC_): redeploy after changing it. Every counted address
# is scrubbed of link tokens first (src/lib/domain/analytics-event.ts).
NEXT_PUBLIC_ANALYTICS=""

# The app's own public URL, used to build the link inside password-reset
# emails. Set to the real production URL once deployed (e.g. Vercel's).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
