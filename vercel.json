{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": false,
      "round/*": false,
      "breaks/*": false,
      "dependabot/*": false
    }
  },
  "crons": [
    {
      "path": "/api/cron/expire-rounds",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/demo-replay",
      "schedule": "15 9 * * *"
    }
  ]
}
