{
  "permissions": {
    "deny": [
      "mcp__plugin_prisma_Prisma-Local__migrate-reset",
      "mcp__plugin_gitkraken_gitkraken__git_stash"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\"",
            "timeout": 30,
            "statusMessage": "Checking the hard rules"
          }
        ]
      }
    ]
  }
}
