// Prisma schema for the Golf Tournament Organizer.
// Postgres in every environment (dev + prod) — the app code goes through
// the repository in src/lib/db, so no query changes needed either way.

generator client {
  provider = "prisma-client-js"
}

// Two URLs, because runtime queries and migrations want different things.
//
// `url` is the POOLED connection. Every Vercel function is its own short-lived
// process, and each one opening a raw TCP connection to Postgres exhausts the
// connection ceiling and produces intermittent P1001 "Can't reach database
// server" — which is exactly what production was doing: a couple of failures
// per hundred requests, scattered across routes, recovering on their own.
//
// `directUrl` is the unpooled one, used only by `prisma migrate deploy` in
// vercel-build. Migrations take advisory locks and run DDL, neither of which
// can go through a query pooler.
//
// Locally both point at the same Postgres, so nothing about development
// changes.
datasource db {
  provider  = "postgresql"
  url       = env("PRISMA_DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

// A person's login identity — separate from Account, which is their
// per-event role. One User (one email, one password) can hold an Account
// on any number of events; password auth checks User, access control
// checks Account. An empty password means the identity exists (an
// organizer pre-provisioned this email as a player/staff Account) but
// hasn't been claimed with a password yet.
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String   @default("")
  password  String   @default("")
  createdAt DateTime @default(now())

  resetTokens PasswordResetToken[]
  memberships OrganizationMember[]
}

/**
 * The billing tenant: a golf club, society, or an individual organizer.
 * Tournaments belong to an organization rather than floating free, so a
 * subscription has something to attach to. Everyone gets one — an individual
 * organizer's is `kind = "personal"` — which keeps a single code path instead
 * of "event with an org" and "event without one".
 * Note what is deliberately *not* here: players. They hold per-event Account
 * rows and are never organization members, so seat counts can never be
 * inflated by the field. Charging a club for its staff should never mean
 * charging its golfers.
 */
model Organization {
  id   String @id @default(cuid())
  name String
  /**
   * club | community | personal — see lib/domain/org-profile.ts, which is the
   * authoritative list and declares what each one MEANS. Do not re-decide the
   * behaviour of a kind by comparing this string; ask `orgProfile()`.
   * club      a club, course or resort. Shared roster, no ledger — the shop
   * takes the entry fee and pays the winner, so the app says who won.
   * community a society, league or regular group. Shared roster AND a ledger:
   * somebody fronted the minibus and is owed by nine others.
   * personal  one organizer running an outing, with their own list of players.
   * This comment used to read `personal | club`, disagreeing with the four
   * kinds in org-profile.ts. Settled on 2026-08-18: org-profile is
   * authoritative, and `course` was dropped there because it held the same
   * value as `club` on every behaviour flag.
   */
  kind String @default("personal")

  /**
   * none | float | split — the club default for what a tournament does with
   * money. Empty follows the kind of outfit (see resolveMoneyMode), which is
   * what every existing club does today.
   */
  moneyMode String @default("")

  // Branding, applied to the console header and printed output for every
  // tournament this organization owns.

  /**
   * Absolute https:// URL to a logo image. A URL rather than an upload
   * because file uploads need blob storage; this works with the club's
   * existing website assets and can be swapped for an upload later without
   * changing anything that reads it.
   */
  logoUrl      String @default("")
  /**
   * Optional short name for tight spaces (headers, print). Falls back to `name`.
   */
  shortName    String @default("")
  /**
   * How the name renders beside the logo: short | full | both.
   */
  brandDisplay String @default("short")

  /**
   * Where the club is.
   * Nothing anchored "courses near us" before this — the app knew a club by
   * name and nothing else, so there was no region to search and no sensible
   * default city when adding a course.
   * Free text rather than a geocoded point: it prefills the course form today
   * and is enough to scope a course lookup later, and asking a golf secretary
   * for coordinates would be asking the wrong question.
   */
  city              String @default("")
  /**
   * State, county or province — whatever the club would write on a letter.
   */
  region            String @default("")
  country           String @default("")
  /**
   * Accent colour preset, from src/lib/themes.ts.
   * A key rather than a hex value, deliberately. Storing raw colour would let
   * a club pick something the app cannot stay readable against; the presets
   * are contrast-checked by test, so whichever is chosen the text survives.
   */
  themeKey          String @default("sunset")
  /**
   * The club's own colour, used when themeKey is "custom". Stored as entered;
   * the ramp built from it fixes lightness, so only hue and saturation are
   * actually honoured — that is what keeps an open field readable.
   */
  themeHex          String @default("")
  /**
   * The second colour — advancing rows, positive deltas, a match won.
   * Defaults to the fairway green, which is the colour of the game rather than
   * of any one club and should usually be left alone. A club whose identity is
   * genuinely two colours has nowhere else to put the second one.
   */
  themeSecondaryKey String @default("fairway")
  themeSecondaryHex String @default("")
  /**
   * dark | light | auto. Light is not just taste: a bright screen is far
   * easier to read at arm's length in direct sun, which is where scores are
   * actually entered.
   * Defaults to `auto` so a new club follows the device. The console reads
   * auto as dark-first and the player-facing board as light-first, which is
   * the point: the same setting resolves to whichever ground suits the screen
   * it is on. Existing clubs keep whatever they already store — this changes
   * the default for new rows only, deliberately not a backfill.
   */
  themeAppearance   String @default("auto")

  // House defaults for new tournaments. Communities often have several
  // organizers who each run their events differently, so these are only a
  // starting point — every tournament keeps its own copy and can diverge.
  defaultLeaderboardVisibility String  @default("participants")
  defaultScoreEntryBy          String  @default("players")
  defaultScoreEntryWindow      String  @default("during")
  defaultVoiceEntry            Boolean @default(true)
  defaultPlayerAccess          String  @default("email")
  defaultScoreApproval         String  @default("staff")

  /**
   * Where this club's handicaps come from — "club" or "ghin".
   *
   * A club position rather than a per-member preference: some clubs run
   * entirely on association figures and an organizer typing an index is a
   * mistake there, not a feature. See domain/handicap-policy.ts, which also
   * decides what a GHIN club plays off when the association cannot be reached
   * — the last figure actually received, labelled with its age, and never
   * zero.
   *
   * Defaults to "club", because a club that has said nothing has not opted
   * into anything.
   */
  /// Association credentials, per capability. See model Integration.
  integrations Integration[]

  handicapPolicy String @default("club")

  /**
   * Which association, when the policy is not "club". See integrations/.
   * Separate from the policy so a club in England can answer to England Golf
   * without the word GHIN appearing anywhere in their settings.
   */
  handicapAuthorityId String @default("ghin")

  /**
   * Whether finished rounds are posted back to the association.
   *
   * A SEPARATE permission from reading indexes, because a club is routinely
   * entitled to look a golfer up and not to write to their record. Off unless
   * a club has explicitly turned it on — posting a score changes a real
   * person's handicap at every club they play, and there is no undo this app
   * controls. See domain/score-posting.ts.
   */
  scoreReportingEnabled Boolean @default(false)
  scoreReporterId       String  @default("ghin")
  /**
   * House default for the per-match points cap. Zero is no cap.
   * A club that always runs its member-guest capped shouldn't have to set it
   * on every event, and an organizer running something different that week
   * shouldn't be stuck with the house rule — so this seeds a new tournament
   * and the tournament can then be changed on its own.
   */
  defaultMaxPerMatch           Float   @default(0)

  /**
   * The club's own course.
   * A golf club plays at its course — every tournament, unless someone says
   * otherwise — so setting it once here spares the organizer choosing a venue
   * they were never going to change. New tournaments start with it as their
   * only venue, which keeps every picker hidden.
   * Null for societies and community organizations, which have no home course
   * and for whom several venues is the normal case rather than the exception.
   * A club is never locked in either: it can add an away venue to any
   * tournament, for a member-guest held elsewhere.
   */
  defaultCourseId String?
  homeCourse      Course? @relation("OrgHomeCourse", fields: [defaultCourseId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /**
   * What a text costs this club, in MILLIONTHS of a currency unit per segment.
   * Micros rather than cents because the number is genuinely smaller than a
   * cent and rounding it to one loses the whole figure: a US segment is about
   * $0.011 all-in, which is 11000 here. Zero means "not set", and the estimate
   * then reports segments only rather than inventing a price.
   * Stored per club because it is not one number: the same message costs
   * roughly $0.011 in the US and £0.04 in the UK, and it changes whenever the
   * carrier changes it. A rate baked into the app would be wrong somewhere on
   * the day it shipped.
   */
  smsRateMicros Int @default(0)

  /**
   * What to put in front of an amount. Not a locale — clubs write their own
   * currency and this is the shortest honest way to let them.
   */
  currencySymbol String @default("$")
  /**
   * The club’s currency as an ISO code, e.g. USD, GBP, JPY.
   * The code rather than the symbol above, because "$" cannot say WHICH
   * dollar and carries nothing about minor units — amounts are stored in
   * minor units, and yen has none. See domain/money-format.
   */
  currency       String @default("USD")

  members      OrganizationMember[]
  roster       Member[]
  courses      Course[]
  events       Event[]
  series       Series[]
  threads      Thread[]
  honours      HonoursEntry[]
  subscription Subscription?
}

/**
 * A golf course the club plays, entered once and reused.
 * Owned by the organization rather than by an event, because the same venue
 * comes back season after season and nobody should retype eighteen stroke
 * indexes for it twice. Built-in presets still exist for common courses; this
 * is for everywhere else.
 */
model Course {
  id             String @id @default(cuid())
  organizationId String

  name    String
  city    String @default("")
  /**
   * Street address as printed. Free text — clubs write these many ways, and
   * a strict shape would only stop somebody saving a real course.
   */
  address String @default("")

  /**
   * The club's Local Rules for this course, as it publishes them.
   * Free text on purpose. Local Rules are about internal out of bounds, ground
   * under repair, a drop zone short of the 12th — no schema will anticipate
   * them, and one that tried would only prevent a club recording the rule it
   * actually plays. Optional: a course with none simply shows nothing.
   * Belongs to the course rather than the event because that is what they
   * describe. A club running four tournaments on the same course should write
   * them once.
   */
  localRules String @default("")

  /**
   * Where this card came from, and whether anyone has checked it.
   * manual   — typed in by the club. Trusted.
   * imported — pulled from the web or a club site. NOT trusted until checked.
   * The distinction is not bureaucracy. A wrong par is obvious the first time
   * someone plays the hole; a wrong stroke index is invisible, and it silently
   * allocates handicap shots to the wrong holes for the life of the course.
   * An imported card is usable, but the app says so until a human confirms it.
   */
  source     String    @default("manual")
  /**
   * When someone at the club confirmed the card is right. Null = unchecked.
   */
  verifiedAt DateTime?
  /**
   * Who confirmed it, for the organizer who asks "says who?".
   */
  verifiedBy String    @default("")
  /**
   * Where an imported card came from, so it can be re-checked or blamed.
   */
  sourceUrl  String    @default("")

  /**
   * JSON number arrays, one entry per hole — same encoding as the custom
   * course fields on Event, which this generalises.
   */
  pars        String
  yards       String
  strokeIndex String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  events       EventCourse[]
  stages       Stage[]
  defaultFor   Event[]
  matches      Match[]
  tees         Tee[]
  homeFor      Organization[] @relation("OrgHomeCourse")

  @@index([organizationId])
}

/**
 * Which courses a tournament may be played on.
 * A single row is the ordinary case and nobody is ever asked to choose. More
 * than one turns on the pickers: a multi-day or multi-week event rotating
 * venues sets the course per round, and a community league where opponents
 * arrange their own match sets it per match.
 */
/**
 * A set of tees, with the ratings that make a handicap mean something.
 * Course Rating and Slope are what convert a portable Handicap Index into the
 * strokes a player actually receives here. Without them the app was scoring
 * everyone off their raw index, which understates strokes on a hard course and
 * overstates them on an easy one — and treats a member-guest playing mixed
 * tees as though the course were identical for everyone.
 * pars and strokeIndex are usually the course's own and stay empty. They exist
 * because championship tees occasionally differ, and a blank means inherit.
 */
model Tee {
  id       String @id @default(cuid())
  courseId String

  /**
   * As printed on the card: Blue, White, Red, Championship.
   */
  name   String
  /**
   * any | men | women — whose card this set is rated for.
   */
  gender String @default("any")

  /**
   * Strokes a scratch golfer is expected to take, e.g. 71.5.
   */
  courseRating Float @default(0)
  /**
   * Difficulty relative to a bogey golfer. 113 is standard; 0 means unrated.
   */
  slopeRating  Int   @default(0)
  /**
   * Par for these tees, which can differ from the course's nominal par.
   */
  par          Int   @default(72)

  /**
   * JSON number arrays, one per hole. Empty inherits from the course.
   */
  yards       String @default("")
  pars        String @default("")
  strokeIndex String @default("")

  position Int @default(0)

  course           Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  players          Player[]
  /// Tournaments played from this set by default, and flights assigned to it.
  /// Both sides are declared because migrations 53 and 54 create the real
  /// foreign keys; without them here, `prisma migrate diff` reports drift and
  /// CI refuses to go further — which is what it is for.
  defaultForEvents Event[]  @relation("EventDefaultTee")
  flights          Group[]  @relation("GroupTee")

  @@index([courseId])
}

/**
 * A season-long competition across many tournaments — an order of merit.
 * Standings aggregate on Member, never on Player: a Player row belongs to one
 * event, so the same golfer entering twelve league rounds is twelve rows. The
 * club roster exists so there is one record of a person to hang a season on.
 * Points come from finishing position rather than score, because a season can
 * mix stroke play, Stableford and match play, and those produce numbers that
 * cannot be added together. Position is the only currency every format shares.
 */
model Series {
  id             String @id @default(cuid())
  organizationId String

  name        String
  description String @default("")

  /**
   * JSON number array: points for 1st, 2nd, 3rd... Empty uses the default.
   */
  pointsTable String @default("")
  /**
   * Count only this many best results. 0 counts everything.
   */
  bestOf      Int    @default(0)
  /**
   * Events a member must play before being ranked. 0 ranks everyone.
   */
  minEvents   Int    @default(0)

  /**
   * active | complete — a finished season stops accepting new events.
   */
  status String @default("active")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  events       Event[]

  @@index([organizationId])
}

model EventCourse {
  id       String @id @default(cuid())
  eventId  String
  courseId String

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([eventId, courseId])
  @@index([eventId])
}

/**
 * A person on the club's roster — the primary record of who plays here.
 * Tournaments draw from this rather than each event holding its own island of
 * names. Before this existed, a member who played twelve events was twelve
 * unrelated rows: no history, no single place to correct a phone number, and
 * no way to answer "what has this member played?".
 * Distinct from OrganizationMember, which is *staff* (who can administer the
 * club). A Member is a golfer; they need no login and never take a seat.
 */
model Member {
  id             String @id @default(cuid())
  organizationId String

  name         String
  email        String @default("")
  phone        String @default("")
  ghin         String @default("")
  homeClub     String @default("")
  gender       String @default("")
  preferredTee String @default("")
  /**
   * Club membership number, where the club uses one.
   */
  memberNumber String @default("")

  /**
   * Current handicap index — the roster's canonical value. Each event entry
   * keeps its own snapshot (Player.handicap), so correcting an index today
   * never rewrites the result of a tournament played last season.
   */
  handicap       Float  @default(0)
  handicapType   String @default("18") // 9 | 18
  handicapSource String @default("manual") // ghin | manual | none

  /**
   * active | inactive — inactive members stay for history but are hidden
   * from the default roster view and from "add to tournament".
   */
  status String @default("active")
  notes  String @default("")

  /**
   * Opted out of being messaged by other members.
   * Deliberately narrow, and the narrowness is the whole design. It stops
   * other players starting a direct conversation with this person and takes
   * them out of the address book. It does NOT silence the organizer: tee
   * times, a frost delay and a change of venue are how somebody finds out
   * where to turn up, and an opt-out that loses them their tee time is a
   * setting nobody can safely use.
   * On Member rather than Player because a communication preference belongs to
   * the person and their club, not to one week's entry — asking somebody to
   * opt out again for every tournament is not offering them a choice.
   */
  messagesOptOut Boolean @default(false)

  /**
   * Agreed to receive text messages. Opt-IN, and separate from everything else
   * on purpose.
   * Somebody who gave a phone number so the organizer could ring them about a
   * tee time has not agreed to receive bulk texts, and treating those as the
   * same thing is exactly the conflation that gets an SMS programme shut down.
   * So a number is necessary and never sufficient: nothing is sent unless this
   * is true.
   */
  smsOptIn Boolean @default(false)

  /**
   * When they texted STOP, or unticked the box. Kept rather than just flipping
   * the flag, because "did you have consent when you sent it" is the question
   * that actually gets asked, and a boolean cannot answer it.
   */
  smsOptOutAt DateTime?

  /**
   * When they opted in, for the same reason.
   */
  smsOptInAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entries      Player[]

  @@index([organizationId])
  @@index([organizationId, status])
}

/**
 * Staff membership in an organization. Distinct from per-event Account
 * roles: this is who belongs to the club, not who does what in one event.
 */
model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  /**
   * owner (billing) | admin (manage events & staff) | member (staff pool)
   */
  role           String   @default("member")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

/**
 * An organization's plan. Every organization has exactly one, including free
 * ones, so billing code never has to treat "no subscription" as a separate
 * case.
 * What a plan *includes* lives in code (src/lib/plans.ts), not here — tier
 * limits change far more often than schemas should, and a price change
 * shouldn't require a migration and a backfill. Only the plan's name is
 * stored.
 * The provider columns are unused until payments are wired up; they exist so
 * that adding Stripe later is a code change, not a migration against live
 * tenant data.
 */
model Subscription {
  id                     String    @id @default(cuid())
  organizationId         String    @unique
  /**
   * Key into PLANS in src/lib/plans.ts.
   */
  plan                   String    @default("free")
  /**
   * active | trialing | past_due | canceled
   */
  status                 String    @default("active")
  /**
   * e.g. "stripe" — empty until a payment provider is connected.
   */
  provider               String    @default("")
  providerCustomerId     String?
  providerSubscriptionId String?
  currentPeriodEnd       DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

/**
 * A one-time, short-lived "forgot password" link. Only the sha256 of the
 * raw token is stored — the raw value lives solely in the emailed URL, so a
 * database read alone can never produce a usable reset link.
 */
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/**
 * Attempt counters for the endpoints reachable without a session: round-code
 * redemption, sign-in, and password reset.
 * In the database rather than in process memory because the app runs on
 * serverless instances that are per-request and cold-start constantly — an
 * in-memory counter gives an attacker a fresh budget every time they land on
 * a new instance, which is most requests. Shared state is the whole point.
 * `key` is `kind:sha256(identifier):window`, so the row holds no readable
 * email address and no live round code. It is the primary key so the counter
 * can be incremented with a single atomic upsert; rows past `expiresAt` are
 * inert and swept on write. Deliberately unrelated to User or Stage: the
 * limit applies before anything is looked up, including to identifiers that
 * do not exist, which is what stops a refusal from confirming that one does.
 */
model RateLimitHit {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

model Event {
  id                String  @id @default(cuid())
  /**
   * Owning tenant. Required so no tournament can exist outside a billing
   * boundary — existing events were backfilled to their organizer's
   * personal organization.
   */
  organizationId    String
  name              String
  dates             String
  format            String  @default("match") // match | stroke
  course            String
  /**
   * The club course this tournament is played at, when it is one of theirs.
   * `course` above is a NAME, and was the only venue this model had — it
   * predates the Course library, and `resolveCourse` still matches on it.
   * Every other venue in the app (a round's, a match's) is an id, so the
   * tournament's own was the last thing picked by typing a string.
   * Both are written together and from the same choice, so they cannot
   * disagree: the id is what was picked, the name is that course's name kept
   * beside it for the readers that still resolve by name. Null for a
   * tournament at a course the club has not catalogued, which stays a
   * perfectly ordinary thing to have.
   * SetNull rather than Cascade: deleting a course must never delete a
   * tournament, exactly as it does not delete a round.
   */
  courseId          String?
  courseRef         Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)
  city              String
  address           String
  // Set when `course` doesn't match a built-in preset — the organizer's own
  // hole-by-hole data (JSON number[18] each), entered via the course setup
  // prompt on Score entry. Empty until saved.
  customPars        String  @default("")
  customYards       String  @default("")
  customStrokeIndex String  @default("")
  regDeadline       String
  /**
   * fixed | open — whether one venue covers the whole tournament.
   * "open" is the society or inter-club league where each pairing arranges
   * its own course. The event-level course stays empty on purpose and the
   * venue is named per match, by whoever enters the card.
   */
  courseMode        String  @default("fixed")
  capacity          Int     @default(32)
  playerCountMode   String  @default("registration") // registration | manual
  manualPlayerCount Int     @default(32)

  // Flight formation + qualification config
  formationRule    String  @default("balanced") // balanced | handicap | seeding | random | manual
  flightMode       String  @default("auto") // auto | count | perFlight
  flightValue      Int     @default(0)
  /**
   * Whether the organizer has signed off the manual draw.
   * Only meaningful for the manual formation rule. The computed rules are
   * regenerated from a policy, so there is nothing to confirm — but a hand-
   * built draw is finished work, and it needs a point where it stops being
   * dragged around by accident.
   */
  flightsConfirmed Boolean @default(false)
  qualifyPerGroup  Int     @default(2)
  qualifyMode      String  @default("perFlight") // perFlight | overall
  qualifyOverall   Int     @default(16)
  /**
   * How the knockout is arranged once qualifiers are decided.
   * single = one bracket; split = two flights drawn by rank; plate = one
   * bracket with first-round losers dropping into a second. Defaults to split
   * because that is what every existing tournament already does — changing the
   * shape of a knockout under a running event would be a silent rule change.
   */
  bracketMode      String  @default("split") // single | split | plate
  /**
   * What shape of tournament this is, asked once at the start.
   * Decides what the rest of setup is about: a single round has no next round
   * to carry into, and a knockout has a bracket where a league has none.
   * Defaults to "series" because that is what every existing tournament was
   * built as — it shows every control, which is the behaviour they have now.
   * A starting point, never a cage. An organizer who adds a bracket to a
   * series has changed their mind, and the app follows.
   */
  shape            String  @default("series") // single | series | knockout
  /**
   * Whether people play as individuals or as a side — asked once, at setup.
   * A DEFAULT, NEVER A CONSTRAINT. Nothing that scores a round may read this.
   * Team-ness is a property of each round's format, because it genuinely
   * varies: a member-guest plays four-ball on Saturday and foursomes on
   * Sunday, and a league changes weekly. Storing "this is a team tournament"
   * as a fact would either block that or be quietly ignored, and an ignored
   * setting is worse than no setting.
   * What it is for is ROUTING. It picks the format a new round starts on, and
   * it lets "Teams & pairs" appear before any team round exists — which it
   * previously could not, so the one screen explaining how to set up team golf
   * was unreachable from the navigation.
   * Defaults to "individual": the common case, and what every existing
   * tournament already behaves as.
   */
  sideStyle        String  @default("individual") // individual | pairs | teams | varies
  /**
   * The season this tournament counts towards, if any.
   * Null is the ordinary case: most tournaments stand alone. Setting it makes
   * the result feed an order of merit, which is what a league or a winter
   * series is.
   */
  seriesId         String?

  // Scoring rules (round-robin stages)
  winPts               Float    @default(3)
  tiePts               Float    @default(1)
  lossPts              Float    @default(0)
  holeRatioPts         Float    @default(0.5)
  bonusPts             Float    @default(0)
  /**
   * Points for playing a match, awarded once per match contested.
   * Not the same as `bonusPts`, which is a single flat award per player no
   * matter how many matches they play. In a weekly league that difference is
   * the whole point: a regular who plays eight and a stand-in who plays one
   * collected the same bonus, so turning up paid nothing.
   * A player who forfeits does not collect it — see Match.forfeitedBy. Zero by
   * default, so no tournament starts paying an appearance point it never
   * asked for.
   */
  playPts              Float    @default(0)
  /**
   * The most a player or side can take from any single match. Zero is no cap,
   * which is what every existing tournament has and keeps.
   * Without one a flight can be settled by a single thrashing: holes won feed
   * into points, so a 7&6 pays several times what a 1-up win pays, and by the
   * last match of the week there is nothing left to play for. Capping the
   * take is standard in member-guest invitationals for exactly that reason.
   */
  maxPerMatch          Float    @default(0)
  tiebreakers          String   @default("[\"head-to-head\",\"holes-won-ratio\",\"fewest-holes-lost\",\"lower-handicap\"]")
  /**
   * How an ALL-SQUARE MATCH is decided — a different question from
   * `tiebreakers` above, which separates players level on points across the
   * whole tournament. This decides one match, on the card in front of you.
   * JSON array of keys from src/lib/domain/match-tiebreak.ts, in order. Empty
   * means a halved match stays halved: correct match play, and exactly what
   * every existing tournament already does.
   */
  matchTiebreakers     String   @default("")
  /**
   * The organizer overriding the registration deadline, either way.
   * null follows the deadline. true closes early. false keeps entries open
   * past it — which is the common case, because deadlines get extended by a
   * word at the bar far more often than they get edited in software.
   */
  registrationOverride Boolean?

  /**
   * Self-service (open) registration — people register themselves from a link
   * the organizer shares, no account required.
   * `registrationToken` is an unguessable id for the public /register/[token]
   * page, minted the same way as shareToken (CSPRNG, see src/lib/codes.ts) and
   * kept stable so the link an organizer has already sent keeps working. Empty
   * until registration is first opened — existing events were never on a public
   * link and must not become reachable by a backfilled token. Enforced unique
   * by a PARTIAL index in the migration (unique where <> ''), which Prisma's
   * schema language can't express: a plain @@unique would make the empty
   * default collide for every event that has never opened registration.
   * `registrationOpen` is the switch. While false the link resolves to the same
   * neutral "not open" page a bogus token gets — closing it must not become an
   * oracle that a tournament exists (same discipline as /live).
   * `registrationApproval` is auto (fill to capacity as confirmed, overflow to
   * the waitlist) or approve (every entry lands pending for the organizer to
   * accept). Reuses Event.capacity, regDeadline and Player.status rather than
   * inventing parallel state.
   */
  registrationToken    String  @default("")
  registrationOpen     Boolean @default(false)
  registrationApproval String  @default("auto") // auto | approve

  inviteMessage String @default("")

  // How players see standings and report scores. Copied from the owning
  // organization's defaults when the tournament is created, then owned
  // outright — changing a house default must never alter the rules of an
  // event already under way. Values and their meanings live in
  // src/lib/tournament-settings.ts.
  leaderboardVisibility String  @default("participants") // staff | participants | public
  scoreEntryBy          String  @default("players") // staff | players
  scoreEntryWindow      String  @default("during") // during | after
  voiceEntry            Boolean @default(true)
  playerAccess          String  @default("email") // email | code | both
  /**
   * Registration asks for a mobile number and refuses without one.
   * Off by default and deliberately per-tournament. A phone number is not
   * needed to run a competition — email is identity here and the app reaches
   * people in the app — so a required field that costs entries has to be the
   * organizer's call for the event that actually needs it. The event that
   * needs it is the shotgun start where somebody has to ring the four that
   * hasn't arrived.
   */
  requirePhone          Boolean @default(false)
  /**
   * none | float | split — this tournament overriding the club default.
   * Empty follows the club, which follows the kind. A society runs a thirty
   * pound roll-up and a three-day trip with a minibus in the same season, and
   * one setting cannot be right for both.
   */
  moneyMode             String  @default("")
  /**
   * Who locks a result: "staff" holds every submitted card for organizer
   * review; "players" keeps the two-player confirmation with a 24h
   * auto-confirm. Defaults to staff — auto-confirming an unreviewed score is
   * not something an organizer should get without asking for it.
   */
  scoreApproval         String  @default("staff") // staff | players
  /**
   * Weekly-league attendance: everyone (no opt in/out — every confirmed
   * player is in every round), opt-out (regulars are in unless they say
   * otherwise), opt-in (only those who put their name down).
   */
  attendanceMode        String  @default("everyone") // everyone | opt-out | opt-in
  /**
   * own | one — which tees this competition is played from.
   * "own" honours a player's stored tee and falls back to the round's, which
   * is how the app behaved before this existed. "one" holds the whole field
   * to the round's set, which is what a club medal played off the whites
   * actually is, and what Rule 6.1b makes a penalty to depart from.
   * Mixed tees need no adjustment beyond the Course Handicap formula: the
   * (CR - par) term already gives the longer tee its strokes.
   */
  teePolicy             String  @default("own") // one | own | player
  /**
   * The tees this tournament is played from.
   * Null falls back to the club's first tee by position, which is what every
   * scoring path did before this existed — so an existing tournament is
   * unchanged until somebody chooses.
   * Per TOURNAMENT rather than per club: the same course is played off
   * different sets by different competitions, so a house default would be
   * wrong about as often as it was right.
   */
  defaultTeeId          String?
  /// Declared because migration 53 creates `Event_defaultTeeId_fkey` for real.
  /// The column was added here without the relation, so schema.prisma and the
  /// migrations disagreed and every CI run stopped at the drift check.
  defaultTee            Tee?    @relation("EventDefaultTee", fields: [defaultTeeId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  /**
   * When players approve, how many playing partners must confirm.
   * "Playing together" is the scoring group — the match, not the foursome.
   */
  attestBy              String  @default("marker") // marker | opponent | all
  /**
   * Unguessable id for the public read-only leaderboard. Always present, but
   * the link only resolves while leaderboardVisibility is "public", so
   * publishing and un-publishing is a single toggle and the URL survives it.
   */
  shareToken            String  @unique

  // Lifecycle
  status         String    @default("draft") // draft | registration | ready | live | completed
  configUnlocked Boolean   @default(false) // organizer override to edit after launch
  launchedAt     DateTime?
  /**
   * When this tournament was marked completed.
   * The clock the free tier's retention runs on. status alone cannot
   * carry it: updatedAt moves for any edit, and the free-text dates field is
   * whatever the organizer typed. Deleting somebody's results needs a
   * timestamp that means exactly one thing.
   */
  completedAt    DateTime?
  /**
   * Keep this tournament until at least this time, whatever the plan says.
   * An explicit reprieve rather than a loophole: demos, a disputed result
   * still being argued over, an event a club has asked to hold. Retention
   * takes the later of the plan window and this, so setting it can only ever
   * extend — it can never shorten a window somebody was promised.
   */
  retainUntil    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  series          Series?           @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  accounts        Account[]
  players         Player[]
  groups          Group[]
  stages          Stage[]
  matches         Match[]
  attendance      RoundAttendance[]
  skinsPots       SkinsPot[]
  bracketWinners  BracketWinner[]
  commentary      Commentary[]
  scorecards      Scorecard[]
  roundHandicaps  RoundHandicap[]
  matchScorecards MatchScorecard[]
  teams           Team[]
  teamScorecards  TeamScorecard[]
  prizes          Prize[]
  announcements   Announcement[]
  auditLogs       AuditLog[]
  courses         EventCourse[]
  expenses        Expense[]
  fundLines       TournamentFund[]
  settlements     Settlement[]
  contests        Contest[]
  sideGames       SideGame[]
  threads         Thread[]

  @@index([organizationId])
  @@index([courseId])

  /// Attempts to post this tournament’s rounds to an association.
  handicapPosts HandicapPost[]
}

model Account {
  id      String @id @default(cuid())
  eventId String
  name    String
  email   String
  role    String @default("player") // admin | player

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, email])
  @@index([eventId])
}

/**
 * One person's entry in one tournament.
 * The identity lives on Member (the club roster); this is the participation:
 * seed, status, flight, and a snapshot of the details as they stood for this
 * event. `handicap` in particular is deliberately a snapshot — correcting a
 * member's index today must not rewrite a tournament played last season.
 */
model Player {
  id       String  @id @default(cuid())
  eventId  String
  /**
   * Roster record this entry belongs to. Optional only so that entries made
   * before the roster existed remain valid; every path that creates a player
   * now goes through a Member.
   */
  memberId String?
  name     String
  handicap Float   @default(0)
  seed     Int
  status   String  @default("confirmed") // confirmed | waitlisted | withdrawn

  // Registration details
  email          String  @default("")
  phone          String  @default("")
  ghin           String  @default("")
  homeClub       String  @default("")
  gender         String  @default("")
  preferredTee   String  @default("")
  handicapSource String  @default("manual") // ghin | manual | none
  handicapType   String  @default("18") // 9 | 18 — which index this handicap number represents
  /**
   * Which tees this entry plays from.
   * Null means the round's default. It matters because the Course Handicap
   * depends on the tees: the same index is worth different strokes off the
   * blues and the reds, which is the whole point of a slope rating.
   */
  teeId          String?

  groupId String?

  event           Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  group           Group?            @relation(fields: [groupId], references: [id], onDelete: SetNull)
  // Removing someone from the roster must not delete tournaments they played
  // in — the entry stays, detached, preserving the result.
  member          Member?           @relation(fields: [memberId], references: [id], onDelete: SetNull)
  tee             Tee?              @relation(fields: [teeId], references: [id], onDelete: SetNull)
  teamMemberships TeamMember[]
  attendance      RoundAttendance[]
  captainOf       Group[]           @relation("FlightCaptain")
  viceCaptainOf   Group[]           @relation("FlightViceCaptain")
  skinsEntries    SkinsEntry[]

  @@index([eventId])
  @@index([groupId])
  @@index([memberId])
}

model Group {
  id            String  @id @default(cuid())
  eventId       String
  name          String
  position      Int
  /**
   * The tees this flight plays from.
   * A club championship is one tournament with three divisions off three
   * sets — championship off the blues, seniors off the whites, ladies off the
   * reds. Setting it here is three decisions rather than one per player.
   * Null means the flight makes no claim, and its players fall through to the
   * round's tees. That is how every flight behaved before this existed.
   */
  teeId         String?
  /// Declared because migration 54 creates `Group_teeId_fkey` for real. Same
  /// omission as Event.defaultTee above, from the same piece of work.
  tee           Tee?    @relation("GroupTee", fields: [teeId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  /**
   * The flight's captain, appointed by the organizer. Sees their own
   * flight's attendance list; never anyone else's. Null = no captain.
   */
  captainId     String?
  captain       Player? @relation("FlightCaptain", fields: [captainId], references: [id], onDelete: SetNull)
  /**
   * Deputises for the captain: same read-only view of the flight's list.
   */
  viceCaptainId String?
  viceCaptain   Player? @relation("FlightViceCaptain", fields: [viceCaptainId], references: [id], onDelete: SetNull)

  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  players Player[]
  matches Match[]

  @@index([eventId])
}

model Stage {
  id                  String   @id @default(cuid())
  eventId             String
  position            Int
  type                String // Round Robin | Qualification Stage | Single Match Stage | Bracket Stage
  description         String   @default("")
  format              String   @default("Match Play") // golf format (see src/lib/formats.ts)
  holes               Int      @default(18) // 9 | 18
  /**
   * The day this round is actually played, as an ISO date ("2026-05-19").
   * Empty means no fixed day.
   * Distinct from `deadline`, and the distinction is the point: a Tuesday
   * league PLAYS on Tuesday, it does not "play by" Tuesday. A knockout round
   * where players arrange their own match still wants a deadline; a fixed-day
   * league wants a date, and had no field to put one in.
   * A plain date string rather than DateTime deliberately. This is a calendar
   * day, not an instant — storing it as a timestamp means a club in one
   * timezone can see "Mon 18 May" for a round everyone played on Tuesday.
   * Per round, so a rained-off week can be moved on its own without touching
   * the rest of the season.
   */
  playedOn            String   @default("")
  deadline            String   @default("")
  /**
   * The organizer closing this round early or extending it past its date.
   * null follows the deadline. Same rule as registration — see
   * src/lib/deadline.ts — because they are the same question asked twice.
   */
  deadlineOverride    Boolean?
  scoringBasis        String   @default("gross") // gross | net | both
  /**
   * How a Single Match Stage picks its two players, as JSON — see
   * lib/domain/single-match.ts. The RULE, not the pair: a pairing written
   * down when the stage was created goes stale the moment an upstream score
   * is corrected, which would put two players in a final the results no
   * longer support. Empty on every other kind of stage.
   */
  singleMatchRule     String   @default("")
  /**
   * Whether a Bracket Stage plays off for third.
   * Off by default — plenty of clubs send everyone to the bar instead, and a
   * fixture nobody asked for is worse than a missing one. The MATCH is not
   * stored here: the pairing is the two beaten semi-finalists and is derived
   * from the semi-finals as they stand, so a corrected result changes who
   * plays it. See lib/domain/third-place.ts.
   */
  thirdPlace          Boolean  @default(false)
  carryForwardEnabled Boolean  @default(false)
  carryForwardPct     Int      @default(0)
  /**
   * Whether the organizer has actually been asked about carry-forward.
   * Distinguishes "they said no" from "nobody ever raised it", which a plain
   * boolean cannot. In a points league whether a strong round still counts is
   * the central decision, and leaving it as an unchecked box halfway down a
   * collapsed panel meant it was made by default rather than on purpose.
   */
  carryForwardAsked   Boolean  @default(false)

  // Field cut entering this round (Round Robin stages after the first): only
  // the top cutCount / cutPercent players from the previous round's standings
  // are scheduled here. Generated separately from the global flight builder
  // via generateNextRound, since it depends on that round's real results.
  cutEnabled Boolean @default(false)
  /**
   * overall | perFlight — out of what the cut is taken.
   * The cut line could only ever take the top N across the whole field, while
   * a separate tournament-level "qualification" setting had per-flight but no
   * percentage. Two half-answers to one question, which an organizer could set
   * to contradict each other.
   */
  cutScope   String  @default("overall")
  cutMode    String  @default("count") // count | percent
  cutCount   Int     @default(16)
  cutPercent Int     @default(50)

  /**
   * The venue for this round, when the tournament rotates them — a
   * multi-day member-guest or a multi-week league playing somewhere new
   * each time. Null means fall back to the event's course.
   */
  courseId String?
  /**
   * Which nine, when the round is 9 holes. full | front | back
   */
  nine     String  @default("full")

  /**
   * Committee override for this round's handicap allowance, as a percentage.
   * Zero means "use the allowance the format recommends", which is what almost
   * every round wants — a stored 0 is therefore not a 0% allowance but an
   * absence of opinion, and that is why this isn't nullable.
   * It exists because the published WHS allowances are recommendations, and
   * the scramble family has no published allowance at all — only a widely used
   * club convention. A committee that sets its own needs somewhere to say so,
   * and the alternative is an app that quietly scores their event under
   * different rules than they announced.
   */
  handicapAllowance Int @default(0)

  /**
   * Committee override for how this round's scores are RECORDED.
   * "gross-cards" | "hole-results" | "match-result" — see MatchEntryMode in
   * lib/domain/match-entry.ts, and GolfFormat.inputs for what each format
   * offers.
   * Empty means "use the input the format declares", exactly as zero does for
   * handicapAllowance and an empty array does for allowanceWeights — so every
   * round that existed before this field records exactly what it always did.
   * A value the format does not offer is IGNORED rather than honoured
   * (resolveScoreInput), because a stored string is caller-supplied and
   * "final result only" on a Stableford round is a shape no engine can read.
   * It exists for one real case: a club that wants full cards from its
   * match-play day, because under WHS a match-play score is acceptable for
   * handicapping only when a full card is returned. That is the difference
   * between a round counting and not, which is not a preference.
   */
  scoreInput String @default("")

  /**
   * Per-player allowance shares for this round, best player first — the
   * committee's version of greensomes' 60/40 or a scramble's descending
   * table.
   * Some shared-ball formats don't take a flat percentage of the combined
   * handicaps, and the split itself varies by club: 60/40 is the common
   * greensomes convention, but 50/50 and 55/45 are all played. `handicapAllowance`
   * is a single number and cannot express any of them.
   * Empty means "use the split the format recommends", exactly as zero does
   * for handicapAllowance — so every round that existed before this field
   * keeps scoring the way it always did.
   */
  // `@default([])` states what migration 36 already gave the column in the
  // database. Without it the schema and the database disagree, and the next
  // unrelated `migrate dev` silently emits a DROP DEFAULT — which is how it
  // nearly rode along with a theme change. The column is NOT NULL, so losing
  // the default would break any INSERT that omits it.
  allowanceWeights Int[] @default([])

  /**
   * How many partners' scores count on each hole, for the formats that
   * aggregate separate balls.
   * Four-ball and ordinary best ball count one — the single best score on the
   * hole. Plenty of club and society days count the best two or three of
   * four instead, which keeps everyone involved on every hole rather than
   * leaving three players spectating once someone makes par.
   * Zero means "use what the format counts", which is one, so every round
   * that existed before this field scores exactly as it did. The scoring
   * engine has always taken this as a parameter; only the setting is new.
   */
  countBest Int @default(0)

  /**
   * Round Code — the shared code players enter to report scores for this
   * round, modelled on the GGID golfers already know from Golf Genius.
   * Per round rather than per player because distribution is the problem that
   * decides whether self-scoring gets used at all: one code read out on the
   * first tee beats forty printed slips. A twelve-round league has twelve
   * codes, and last week's stops working.
   * The trade is real and deliberate: a shared code proves membership of the
   * round, not identity, so the player picks their own name after entering it.
   * Empty unless the tournament has code access switched on.
   */
  accessCode        String  @default("")
  /**
   * Last day a player may change their in/out for this round (inclusive,
   * same reading as every other deadline — see src/lib/deadline.ts). Empty
   * means changes stay open. Staff always may.
   */
  optDeadline       String  @default("")
  /**
   * The round's tee sheet, saved as drawn.
   * JSON rather than rows on purpose: a sheet is replaced wholesale on every
   * regenerate, read as a unit, and never queried relationally — groups with
   * their players, start holes and times. Empty until an organizer saves one;
   * until then the sheet exists only in their browser, which is why nothing
   * downstream could ever use it.
   */
  teeSheet          String  @default("")
  /**
   * Whether players may see it. Drafts stay the organizer's.
   */
  teeSheetPublished Boolean @default(false)

  event      Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  course     Course?           @relation(fields: [courseId], references: [id], onDelete: SetNull)
  matches    Match[]
  teams      Team[]
  attendance RoundAttendance[]
  skinsPots  SkinsPot[]
  // Redemption looks a code up on its own, so codes must be unique across
  // every tournament. Enforced by a *partial* unique index in the migration
  // (unique where accessCode <> ''), which Prisma's schema language can't
  // express — a plain @@unique would make the empty default collide for every
  // round that has no code.

  @@index([eventId])
}

/**
 * One player's explicit in/out for one round of a league.
 * Only explicit choices are rows. Absence means the tournament's default —
 * in for an opt-out league, out for an opt-in one — which is what lets an
 * organizer flip a forty-player league to opt-out without writing forty
 * rows, and lets "by default you're in" be literally true.
 */
model RoundAttendance {
  id        String   @id @default(cuid())
  eventId   String
  stageId   String
  playerId  String
  status    String // in | out
  decidedAt DateTime @default(now())
  /**
   * Who flipped it — the player themself, or a staff name. The answer to
   * "why am I not playing this week" has to name a person.
   */
  decidedBy String   @default("")

  event  Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  stage  Stage  @relation(fields: [stageId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([stageId, playerId])
  @@index([eventId])
}

model Match {
  id        String @id @default(cuid())
  eventId   String
  stageId   String
  groupId   String
  round     Int
  /**
   * The two sides.
   * In an individual format these are Player ids and the team columns are
   * empty. In a team format the team columns hold the sides and these are
   * empty — deliberately not repurposed to hold a team id, because a column
   * whose meaning depends on the round's format is the kind of thing that
   * silently mis-joins a year later.
   * Empty string rather than null, matching how the rest of the schema models
   * "not set", so the pairing can be read without null-juggling.
   */
  playerAId String
  playerBId String
  teamAId   String @default("")
  teamBId   String @default("")
  // JSON array of 'A' | 'B' | 'H' | null, one per hole.
  holes     String @default("[]")

  /**
   * The side that forfeited, when the match was not played out.
   * Covers the concession of a match (Rule 3.2b(1)), a no-show and a
   * withdrawal — all of which end a match without a card, and none of which
   * could be recorded at all. An organizer's only options were to invent a
   * scoreline or leave the match Live forever.
   * Holds a player id in an individual round and a team id in a team round,
   * mirroring whichever pair of columns above the round uses. Empty means the
   * match was played.
   * When set it OVERRIDES `holes`: the opponent takes the win however many
   * holes were entered before the player walked in, because a conceded match
   * is won rather than led. Those holes are also kept out of the standings —
   * crediting a conceder the holes he was up would flatter him in the hole
   * differential his flight is ranked on.
   */
  forfeitedBy String @default("")

  /**
   * The venue this particular match was played at.
   * Null means inherit — from the round, then the event — which is the normal
   * case for a tournament that booked its courses in advance. It is set where
   * the organizer couldn't know: a community league whose opponents arrange
   * their own match somewhere of their choosing before the deadline.
   * Inheriting is the default, never a restriction. The organizer can always
   * set this on any match — a pairing that had to move venue at short notice
   * is exactly the kind of thing no inference should be able to lock them out
   * of correcting.
   */
  courseId String?
  /**
   * Which nine, when the round is 9 holes. full | front | back
   */
  nine     String  @default("full")

  // Score confirmation (two-player workflow)
  scoreStatus   String    @default("pending") // pending | confirmed | disputed
  scoredAt      DateTime?
  /**
   * Who wrote the score down, as a display name. A result that nobody can be
   * traced to is not a result a committee can defend, and this was the half
   * of the trail that was never recorded — confirmedById existed but was only
   * ever written as null.
   */
  enteredBy     String    @default("")
  confirmedById String?
  /**
   * Who signed it off, as a display name, alongside the id.
   */
  confirmedBy   String    @default("")

  event           Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  stage           Stage            @relation(fields: [stageId], references: [id], onDelete: Cascade)
  group           Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  course          Course?          @relation(fields: [courseId], references: [id], onDelete: SetNull)
  matchScorecards MatchScorecard[]

  @@index([eventId])
  @@index([stageId])
  @@index([groupId])
}

model AuditLog {
  id        String   @id @default(cuid())
  eventId   String
  matchId   String?
  actor     String   @default("")
  action    String
  detail    String   @default("")
  createdAt DateTime @default(now())

  // Cascade like every other per-event table. Without this relation the rows
  // survived their tournament being deleted, leaving orphaned records that
  // still named the people involved (`actor`) — deleting a tournament must
  // purge everything belonging to it.
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model BracketWinner {
  id       String @id @default(cuid())
  eventId  String
  // Key: "{winners|consolation}-{roundIndex}-{matchIndex}"
  key      String
  winnerId String
  result   String @default("") // recorded match result, e.g. "3&2"

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, key])
  @@index([eventId])
}

model Commentary {
  id        String   @id @default(cuid())
  eventId   String
  author    String   @default("")
  text      String
  source    String   @default("organizer") // organizer | ai
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

/**
 * A prize / payout line — flight winner, skin, closest-to-pin, etc.
 */
model Prize {
  id       String  @id @default(cuid())
  eventId  String
  position Int     @default(0)
  category String // e.g. "Flight 1 — Winner", "Skins", "Closest to Pin (Hole 7)"
  detail   String  @default("")
  amount   Float   @default(0)
  winnerId String? // optional Player id once awarded

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

/**
 * An announcement pushed to players (schedule change, notice, results).
 */
model Announcement {
  id        String   @id @default(cuid())
  eventId   String
  title     String
  body      String   @default("")
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

/**
 * Individual stroke-play scorecard for a player in a round.
 */
/**
 * A side in a team format — a member-guest pairing, a scramble four, a
 * four-ball partnership.
 * `stageId` decides how long the team lasts. Null means it plays the whole
 * tournament, which is the member-guest case where a pairing is the entry
 * itself. Set to a round means the teams were drawn for that round only, which
 * is how a society mixes its field up week to week. Both are common, so
 * neither is the model.
 */
model Team {
  id      String  @id @default(cuid())
  eventId String
  stageId String?
  name    String
  /**
   * Seeding/draw order, and the display order on a leaderboard.
   */
  seed    Int     @default(0)

  createdAt DateTime @default(now())

  event      Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  stage      Stage?          @relation(fields: [stageId], references: [id], onDelete: Cascade)
  members    TeamMember[]
  scorecards TeamScorecard[]

  @@index([eventId])
  @@index([stageId])
}

model TeamMember {
  id       String @id @default(cuid())
  teamId   String
  playerId String
  /**
   * Order within the side. Not cosmetic: foursomes alternate who tees off on
   * odd and even holes, and the scramble allowance table is applied in ability
   * order, so a side's members are a sequence rather than a set.
   */
  position Int    @default(0)

  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  // Nobody plays for the same side twice.
  @@unique([teamId, playerId])
  @@index([teamId])
  @@index([playerId])
}

/**
 * A team's card for one round.
 * `playerId` is what distinguishes the two shapes of team golf:
 * Empty — the side plays one ball and there is a single card for the team
 * (foursomes, scramble, Chapman).
 * Set — each partner keeps their own card and the team's score is derived
 * per hole (four-ball, best ball, shamble). One row per partner.
 * Empty string rather than null so the unique constraint below actually
 * constrains: Postgres treats nulls as distinct, so a nullable column here
 * would happily accept two cards for the same single-ball side.
 * `matchId` is empty for a team stroke-play round, which has no opponent, and
 * set for team match play, where each match needs its own card.
 */
model TeamScorecard {
  id       String @id @default(cuid())
  eventId  String
  stageId  String
  teamId   String
  matchId  String @default("")
  playerId String @default("")
  // JSON array of per-hole gross strokes (number | null), one per hole.
  strokes  String @default("[]")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  team  Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([stageId, matchId, teamId, playerId])
  @@index([eventId])
  @@index([teamId])
}

model Scorecard {
  id       String @id @default(cuid())
  eventId  String
  stageId  String
  playerId String
  // JSON array of per-hole gross strokes (number | null), one per hole.
  strokes  String @default("[]")

  /**
   * Where this card is in the two steps Rule 3.3b describes.
   * entered   — written down. Not yet claimed to be right by anyone.
   * certified — the marker and player say the hole scores are correct. This
   * is the card being returned.
   * approved  — the committee has accepted it. Only now is it a result.
   * disputed  — someone has said it is wrong. Never silently becomes
   * approved; a blanket approval must step around it.
   * Match play has had this since the start, on Match.scoreStatus. Stroke play
   * did not, so a card went straight from a text box to the leaderboard with
   * nothing in between — which mattered much more once one person in a
   * fourball could enter three other people's rounds.
   */
  status String @default("entered")

  /**
   * Who certified the hole scores, and when. The marker, in Rule terms.
   */
  certifiedBy String    @default("")
  certifiedAt DateTime?

  /**
   * Who accepted it for the committee, and when. Kept even after a reopen:
   * the question "who signed this off" must survive the card changing.
   */
  approvedBy String    @default("")
  approvedAt DateTime?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([stageId, playerId])
  @@index([eventId])
}

/**
 * What one player plays off in ONE round.
 * Same shape as Scorecard above — a row per round per player — deliberately, so
 * there is one pattern for "a fact about this player in this round" rather than
 * two.
 * The app derives net scores and stores none of them, which is right. But a
 * handicap read live means an organizer editing a roster handicap in round three
 * silently re-scores round one: a finished round, possibly a settled cut,
 * possibly a pot already paid out. So the INPUT is frozen rather than the
 * output. Net stays derived; what it derives from stops moving.
 * A row is only written when there is something to say. No row means the player
 * plays off the roster handicap, which is the requirement's default.
 * Resolution lives in `src/lib/domain/round-handicap.ts` and nowhere else —
 * frozen > override > member. Both numbers are COURSE handicaps, the same unit
 * the roster and the board use, so the round's allowance still applies on top.
 * Mixing units is the defect the 2026-08-12 audit found, where one screen priced
 * a card off an index and another off a Course Handicap, five shots apart.
 */
model RoundHandicap {
  id       String @id @default(cuid())
  eventId  String
  stageId  String
  playerId String

  /**
   * The committee's decision for this round, set before play. Null = none.
   */
  override Int?

  /**
   * What this round was actually scored against. Written once, when the round's
   * first card is returned, and never rewritten — including when the override
   * changes afterwards. An organizer who changes their mind after cards are in
   * has changed their mind; a played round is not a thing anyone gets to change
   * their mind about.
   */
  frozen   Int?
  frozenAt DateTime?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([stageId, playerId])
  @@index([eventId])
}

/**
 * One side's gross-strokes card for a single match-play match (net or gross
 * "Scorecard" entry mode). Deliberately separate from Scorecard above: that
 * model is keyed by (stage, player) for standalone Stroke Play rounds, and a
 * player can also be a match-play participant in the same stage — keying
 * this one by (match, slot) instead avoids the two features colliding on
 * the same row.
 */
model MatchScorecard {
  id      String @id @default(cuid())
  eventId String
  matchId String
  slot    String // "A" | "B"
  // JSON array of per-hole gross strokes (number | null), one per hole.
  strokes String @default("[]")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, slot])
  @@index([eventId])
}

/**
 * A skins pot on one round of a league.
 * Attached to a round rather than the event because a league runs one a week,
 * and each week stands alone: its own entrants, its own pot, its own result.
 * Entrants are stored explicitly rather than derived from who is playing.
 * Attendance answers "are you here this week"; this answers "did you put money
 * in", which is a cash transaction at the first tee that only the person
 * collecting it knows about. Plenty of players play the round and stay out of
 * the skins, and entering them anyway would produce a settlement sheet that is
 * wrong in the way that loses a club's trust.
 * Money is only ever CALCULATED and RECORDED here. TourneyHQ does not move it.
 */
model SkinsPot {
  id      String @id @default(cuid())
  eventId String
  /**
   * A club often runs BOTH on the same night: a gross pot for the low
   * handicaps and a net one so everybody has a chance. They are separate
   * games with separate money, so a round can hold one of each.
   */
  stageId String

  /**
   * Stake per player, in whole cents, so no total is ever a rounded float.
   */
  buyInCents Int     @default(0)
  /**
   * Net applies handicap strokes per hole — what makes skins playable in a
   * mixed-ability club field. Gross is a scratch player's game.
   */
  net        Boolean @default(true)
  /**
   * full | front | back. A league playing 18 may run skins on the front only,
   * so this is independent of the round's own hole count.
   */
  scope      String  @default("full")

  /**
   * Players who paid in. Entered by club staff, never inferred.
   */
  entrants SkinsEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  stage Stage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  /**
   * The SCOPE is part of the key, and leaving it out was a money bug.
   * A league night runs four games: front and back, each gross and net. Keyed
   * on (stageId, net) alone, saving the back-nine gross pot UPSERTED the
   * front-nine gross one — same row, so the front pot's entrants and their
   * stakes silently became the back pot's, and the front game vanished with
   * the money still recorded against it.
   */
  /// Which fourball this pot belongs to, or "" for the whole field.
  ///
  /// The tee sheet is JSON on the Stage and its groups have no stable id, so
  /// this is the group's NAME ("Group 3") rather than a foreign key. That is
  /// deliberate: the pot's actual membership is its `entrants` rows, and this
  /// is only how a pot is addressed and labelled. If a redraw renames the
  /// groups the pot keeps its entrants and its money and simply stops matching
  /// a current group — money is never deleted by a draw being redone.
  groupKey String @default("")

  /// One pot per round, per net/gross, per nine, PER GROUP.
  ///
  /// `groupKey` is in the key because without it there is exactly one skins
  /// pot per round and a second fourball's game overwrites the first — the
  /// same silent overwrite that lost the back-nine pot when the key was
  /// [stageId, net] and front and back collided. Empty groupKey is the
  /// whole-field pot, so every pot that existed before this keeps its meaning.
  @@unique([stageId, net, scope, groupKey])
  @@index([eventId])
}

/**
 * One player's stake in one week's pot.
 */
model SkinsEntry {
  id       String @id @default(cuid())
  potId    String
  playerId String

  /**
   * Somebody has the cash. Same rule and same reason as SideGameEntry and
   * ContestEntry: a name put down in the app is an INTENTION, not a stake,
   * and only a stake reaches the ledger.
   *
   * Skins was the one pot without this, so it was also the one pot nobody
   * could ask to join — an entry row was instantly real money, and there was
   * no way to say "I want in" that did not also say "I have paid". Adding it
   * is what lets a player in another fourball put their name down.
   *
   * Defaults TRUE, which is what makes the migration safe on a populated
   * database: every row that exists today was written by somebody ticking a
   * player in, which IS the confirmation. Defaulting false would have turned
   * every stake in every live pot into an unpaid request overnight.
   */
  confirmed Boolean @default(true)

  pot    SkinsPot @relation(fields: [potId], references: [id], onDelete: Cascade)
  player Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([potId, playerId])
  @@index([playerId])
}

/**
 * One thing somebody paid for on an outing.
 * Money is INTEGER CENTS, never a float, and `amountCents` may be NEGATIVE:
 * that is a refund or credit — a returned deposit, a cancelled cart — which
 * splits exactly like a charge and lands the other way round.
 * `paidBy` is a Player id but deliberately NOT a relation. A Player row with
 * no scores can still be hard-deleted, and a foreign key would either block
 * that delete or cascade this expense away and unbalance a ledger that other
 * people are settling against. The domain module keeps a departed player's
 * side of the balance and the screen renders them as unknown; see
 * domain/expenses.ts.
 */
model Expense {
  id      String @id @default(cuid())
  eventId String
  /**
   * The round this belongs to. Empty means the whole outing.
   */
  stageId String @default("")

  description String
  amountCents Int
  /**
   * Player id of whoever actually paid the bill.
   */
  paidBy      String
  /**
   * green-fees | cart | lodging | food | travel | other. Free text, because
   * a club will always have a category nobody predicted.
   */
  category    String @default("")
  /**
   * The calendar day it was spent, ISO — a day, not an instant.
   */
  spentOn     String @default("")

  /**
   * Display name of whoever entered it, for the audit trail.
   */
  createdBy String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shares   ExpenseShare[]
  payments ExpensePayment[]
  event    Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([stageId])
}

/**
 * One player's share of one expense.
 * `weight` is relative: 1 each is an even split, 2 is a double share, and 0
 * means on the outing but not on this bill — which is a different fact from
 * having no row at all, and worth keeping.
 */
model ExpenseShare {
  id          String @id @default(cuid())
  expenseId   String
  playerId    String
  weight      Int    @default(1)
  /// An exact amount in cents for this person, overriding weight. Null on
  /// almost every row: weights already cover equal splits, double shares and
  /// percentages. This is for a bill whose real amounts do not reduce to a
  /// small ratio — two rooms at different rates, or a restaurant bill split
  /// by what each person actually ordered. If ANY share on an expense sets
  /// it, the whole expense is split by exact amounts and weights are ignored.
  amountCents Int?

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@unique([expenseId, playerId])
  @@index([expenseId])
}

/// One person actually putting money down for one expense.
///
/// A bill is not always one card. Two of them split the dinner at the till,
/// one puts the rooms on his card and another the buggies. Recorded as a
/// single payer, whoever enters it has to either name the wrong person or
/// break one bill into several — and the second is worse, because the ledger
/// then says the group ate two dinners.
///
/// NO ROWS means the expense's own paidBy covered the lot, which is what every
/// expense written before this model existed means. When rows do exist their
/// amounts must total the expense: balances() is only zero-sum because the
/// credits total the bill.
model ExpensePayment {
  id          String @id @default(cuid())
  expenseId   String
  playerId    String
  amountCents Int

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@unique([expenseId, playerId])
  @@index([expenseId])
}

/**
 * A settle-up that happened.
 * A FACT, not a status: who handed what to whom, when, and who recorded it.
 * There is deliberately no state machine here — no partial payments, no
 * reminders, no confirmations — because the app does not move the money and
 * modelling a payment flow it cannot observe would be inventing certainty.
 * Recorded rather than derived so that a settle-up survives a later expense
 * being added: the ledger from that point is the standing position MINUS what
 * has already changed hands.
 */
model Settlement {
  id      String @id @default(cuid())
  eventId String

  fromPlayerId String
  toPlayerId   String
  cents        Int

  /**
   * Display name of whoever marked it settled.
   */
  recordedBy String   @default("")
  settledAt  DateTime @default(now())

  /**
   * What the ledger said was owed, from this player to that one, at the moment
   * the payment was recorded.
   *
   * The standing position is worked out LIVE from the expenses, the skins and
   * the side games. So a settlement that exactly cleared a debt stops looking
   * like one as soon as any input moves — an expense corrected a week later,
   * a skins result adjusted, a money rule fixed — and the row alone cannot
   * distinguish "they paid what they owed" from "they underpaid".
   *
   * Nullable, and never backfilled. Rows written before this genuinely do not
   * know, and a zero would say "nothing was owed", which is a claim rather
   * than an absence.
   */
  owedCents Int?

  /**
   * Which generation of the money rules produced `owedCents`.
   *
   * See `moneyRulesVersion` — it is derived from what the rules answer, not
   * from a number somebody remembers to increment, so it moves on its own the
   * day apportionment or netting changes. Empty on rows written before it
   * existed.
   */
  rulesVersion String @default("")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

/**
 * A player-funded side bet: closest to the pin, long drive, or whatever the
 * first tee invented.
 * Deliberately NOT a `Prize`. A prize is club money — the club pays the winner
 * $50 and nobody owes anybody, so it must never enter a player settle-up. This
 * is players' money moving between players, which is why it carries a buy-in
 * and an entrant list and why its nets join the outing's one ledger.
 * Simpler than SkinsPot in the one way that matters: no per-hole carry. A pot,
 * and whoever won it — more than one winner being a tie, split to the cent.
 */
model Contest {
  id      String @id @default(cuid())
  eventId String
  /**
   * The round it was played in. Empty means the whole outing.
   */
  stageId String @default("")

  /**
   * closest-pin | long-drive | other
   */
  kind String @default("other")
  /**
   * What the organizer called it — "KP 7th", "Long drive, 12th".
   */
  name String
  /**
   * The hole it was played on, where that means something. 0 for none.
   */
  hole Int    @default(0)

  /**
   * Stake per entrant, integer cents. Zero is a free contest.
   */
  buyInCents Int @default(0)

  /**
   * opt-in | opt-out — see lib/domain/pot-entry.ts.
   * opt-in: a name is in because somebody put it there.
   * opt-out: everyone in the field is in unless they said otherwise, which is
   * how a weekly league and a closest-to-the-pin actually run. Per pot, and a
   * pot hangs off a round, so different rounds can run different games.
   */
  entryMode String @default("opt-in")

  entrants ContestEntry[]

  createdBy String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([stageId])
}

/**
 * One player in one contest, and whether they won it.
 * `won` on the entry rather than a winner column on the contest, because a tie
 * is two winners and a single column cannot hold that — and a tie is the
 * common case for closest to the pin at a society day.
 */
model ContestEntry {
  id        String  @id @default(cuid())
  contestId String
  playerId  String
  won       Boolean @default(false)
  /**
   * Whether the organizer has the money.
   * A player can put their own name down from the app, which is an INTENTION
   * and not a stake — the cash is handed over on the first tee, and until it
   * is, counting them in would tell three other people they are owed money
   * that does not exist. Only confirmed entries reach the ledger.
   * Defaults TRUE because an organizer ticking somebody in IS the
   * confirmation; the self-signup action is the only thing that writes false.
   */
  confirmed Boolean @default(true)
  /**
   * Explicitly out. A decision about PLAYING, where confirmed is a decision
   * about MONEY — "took himself out" and "has not paid yet" settle
   * differently, so they are not one column.
   */
  excluded  Boolean @default(false)

  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)

  @@unique([contestId, playerId])
  @@index([contestId])
}

/**
 * A side bet the CARDS settle: low gross, low net, a birdie pot, an eagle pot,
 * or a Nassau.
 * The difference from `Contest` is where the winner comes from. A contest is
 * manual because no scorecard records who was closest to the pin; this is
 * derived, so there is deliberately NO winner column — storing one would let
 * a typed result contradict the scores it was supposed to come from.
 * Per round, like the skins pot, because a pot settles on the night it was
 * played. A Nassau is per round too and applies to every match in it at the
 * same stake, which is how a club actually calls one.
 */
model SideGame {
  id      String @id @default(cuid())
  eventId String
  stageId String

  /**
   * low-gross | low-net | birdies | eagles | nassau
   */
  kind String

  /**
   * Stake per entrant, integer cents. For a Nassau this is the stake on EACH
   * of the three segments — a "$5 Nassau" is 500 here, and can cost $15.
   */
  buyInCents Int @default(0)

  /**
   * opt-in | opt-out — see lib/domain/pot-entry.ts.
   * opt-in: a name is in because somebody put it there.
   * opt-out: everyone in the field is in unless they said otherwise, which is
   * how a weekly league and a closest-to-the-pin actually run. Per pot, and a
   * pot hangs off a round, so different rounds can run different games.
   */
  entryMode String @default("opt-in")

  entrants SideGameEntry[]

  createdBy String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  /// Which fourball this game belongs to, or "" for the whole field. Same
  /// reasoning as SkinsPot.groupKey — see there.
  groupKey String @default("")

  /// One game of each kind per round, PER GROUP. Without groupKey a second
  /// fourball's Nassau overwrites the first.
  @@unique([stageId, kind, groupKey])
  @@index([eventId])
}

/**
 * One player staking in one derived side game.
 */
model SideGameEntry {
  id         String  @id @default(cuid())
  sideGameId String
  playerId   String
  /**
   * The organizer has the cash. Same rule and same reason as
   * ContestEntry.confirmed: a name put down in the app is an intention, not
   * a stake, and only a stake reaches the ledger.
   */
  confirmed  Boolean @default(true)
  /**
   * Explicitly out. A decision about PLAYING, where confirmed is a decision
   * about MONEY — "took himself out" and "has not paid yet" settle
   * differently, so they are not one column.
   */
  excluded   Boolean @default(false)

  sideGame SideGame @relation(fields: [sideGameId], references: [id], onDelete: Cascade)

  @@unique([sideGameId, playerId])
  @@index([sideGameId])
}

/**
 * A conversation.
 * Scoped by `scopeKey` — `kind:id`, see domain/messaging.ts — because every
 * read is `scopeKey IN (the set derived for this reader)`. Membership is never
 * stored for the structural scopes: a player moves flight, a tee sheet is
 * republished, a side is redrawn, and a stored recipient list would keep
 * showing the conversation to somebody who has left it. Deriving it from the
 * tournament each time cannot go stale.
 * `organizationId` is always set; `eventId` is null only for a club-wide
 * thread, which by definition outlives any one tournament.
 */
model Thread {
  id             String   @id @default(cuid())
  organizationId String
  eventId        String?
  /**
   * `kind:id`. Empty id for club/event/staff, which the event already names.
   */
  scopeKey       String
  title          String   @default("")
  createdByEmail String   @default("")
  createdByName  String   @default("")
  createdAt      DateTime @default(now())
  /**
   * Denormalised so the thread list sorts without touching every message.
   */
  lastMessageAt  DateTime @default(now())
  archived       Boolean  @default(false)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        Event?       @relation(fields: [eventId], references: [id], onDelete: Cascade)

  messages     Message[]
  participants ThreadParticipant[]
  reads        ThreadRead[]

  /**
   * The lookup every read does.
   */
  @@index([organizationId, scopeKey])
  @@index([eventId, scopeKey])
  @@index([lastMessageAt])
}

model Message {
  id          String    @id @default(cuid())
  threadId    String
  authorEmail String
  authorName  String    @default("")
  body        String
  createdAt   DateTime  @default(now())
  editedAt    DateTime?
  /**
   * Soft delete: a removed message leaves a tombstone so the thread still
   * reads as a conversation rather than silently losing a turn.
   */
  deletedAt   DateTime?

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

/**
 * Named participants of a DIRECT thread only.
 * The structural scopes derive their membership and must not have rows here —
 * that is what keeps them from going stale.
 */
model ThreadParticipant {
  id       String @id @default(cuid())
  threadId String
  email    String

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([threadId, email])
  @@index([email])
}

/**
 * How far one person has read one thread.
 * A watermark rather than a row per message: one row per person per thread,
 * and "what is new" is a timestamp comparison.
 */
model ThreadRead {
  id         String   @id @default(cuid())
  threadId   String
  email      String
  lastReadAt DateTime @default(now())

  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([threadId, email])
  @@index([email])
}

/**
 * One text we tried to send.
 * Kept because SMS is the one thing in this app that costs money per use and
 * that a regulator may ask about. Two questions have to be answerable months
 * later: what did this cost, and did we have consent when we sent it. Neither
 * can be answered from the messages themselves.
 * Deliberately stores the number as sent rather than pointing at the Member —
 * a member who later changes their number must not silently rewrite the record
 * of where a message actually went.
 */
model SmsDelivery {
  id             String  @id @default(cuid())
  organizationId String
  eventId        String?
  /**
   * The Thread this went out for, when it was a broadcast of one.
   */
  threadId       String?
  /**
   * `kind:id` — which level the organizer sent to.
   */
  scopeKey       String  @default("")

  toPhone    String
  toName     String @default("")
  body       String
  /**
   * What this was billed as: segments, not messages.
   */
  segments   Int    @default(1)
  /**
   * queued | sent | delivered | failed | skipped
   */
  status     String @default("queued")
  /**
   * Carrier or provider error, kept verbatim for support.
   */
  error      String @default("")
  /**
   * The provider's own id, for reconciling against their invoice.
   */
  providerId String @default("")

  /**
   * Who sent it — an organizer's email, for the audit question.
   */
  sentByEmail String   @default("")
  createdAt   DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([eventId])
  @@index([threadId])
}

/**
 * An outbound email that did not reach its recipient.
 * Recorded because every email send in this app is fire-and-forget by design —
 * the on-screen confirmation is the real receipt, and a bounced confirmation
 * must never undo a real entry. That leaves a failure with nowhere to appear.
 * See lib/domain/email-trouble.ts for what is done with these.
 */
model EmailFailure {
  id             String  @id @default(cuid())
  organizationId String
  eventId        String?

  /**
   * registration | reset
   */
  kind   String
  /**
   * quota | rejected | unconfigured — see classifySendFailure.
   */
  reason String
  /**
   * The provider's message, verbatim, for support.
   */
  detail String @default("")

  /**
   * Who missed out. Empty for password resets: the organizer's action there is
   * to fix the mail setup, not to contact the person, and a durable list of who
   * forgot their password is a record worth not keeping.
   */
  toEmail String @default("")
  toName  String @default("")

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
}

/**
 * A line in a tournament's kitty — the FLOAT money mode.
 * Deliberately not an Expense with a negative amount. The split ledger next
 * door divides amounts between players, and a negative there would silently
 * invert a debt; `direction` says which way the money went and cannot be
 * mistaken for a discount.
 * Also deliberately not per player. A float is one pot belonging to the
 * tournament: fees have already left the entrants' hands, so there is nobody
 * to owe anybody. Per-player reconciliation ("did all forty pay?") is a real
 * want and a separate feature — see docs/audit-2026-08-12.md.
 */
model TournamentFund {
  id      String @id @default(cuid())
  eventId String
  /**
   * The round it belongs to. Empty means the whole outing — a trophy is for
   * the tournament, a round's prize money is for that round.
   */
  stageId String @default("")

  /**
   * in | out. Fees and collections in; prizes, trophies and the meal out.
   */
  direction   String
  description String
  amountCents Int
  /**
   * entry-fee | prize | trophy | catering | other. Free text, because a club
   * will always have a category nobody predicted.
   */
  category    String @default("")
  /**
   * The calendar day, ISO — a day, not an instant.
   */
  occurredOn  String @default("")

  createdBy String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, stageId])
}

/**
 * Every course the public directory knows, held locally.
 * Not a Course. A Course belongs to an organization and is a club's own
 * record, edited and verified by them; this is the shared catalogue searches
 * run against, and adding one to a club COPIES it into a Course so the club's
 * corrections stay theirs and a later refresh of the catalogue cannot
 * overwrite them.
 * Keyed by the directory's own id, so re-running the import updates rather
 * than duplicating.
 * The card is stored EXACTLY as the importer judged it: the hole arrays are
 * empty where `cardFrom` refused the source, and `cardProblem` says why. A
 * catalogue that quietly filled those in would put a fabricated par 72 in
 * front of every club in the country, which is the mistake deleting the
 * bundled courses was for, at 16,822 times the scale.
 */
model CourseCatalog {
  /**
   * The directory's id, not ours.
   */
  id      String @id
  name    String
  city    String @default("")
  state   String @default("")
  /**
   * ISO 3166-1 alpha-2, from the directory. Empty where it does not say.
   * The directory is global — it was walked state by state only because the
   * only listing endpoint is per US state, which made it look US-only. A
   * course outside the US has no `state` at all, so without this a Dutch
   * club is stored with two blank location fields and is unfindable.
   */
  country String @default("")
  website String @default("")
  address String @default("")
  /**
   * The course's nominal par, for the search list and as a check on a
   * pasted card's total. 0 when the directory does not say.
   */
  par     Int    @default(0)

  /**
   * JSON number arrays, or "" where the source had no card worth trusting.
   */
  pars        String @default("")
  yards       String @default("")
  strokeIndex String @default("")
  /**
   * JSON array of { name, gender, courseRating, slopeRating, par, yards }.
   */
  tees        String @default("[]")
  /**
   * Why the card was refused, in the words a club needs. Empty when it was
   * taken — so this doubles as the flag for "catalogued without a card".
   */
  cardProblem String @default("")

  fetchedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([state])
  @@index([country])
}

/**
 * A name on the club's board — the permanent record, not a view of the data.
 * Deliberately DENORMALISED, and that is the whole design. Every field a board
 * needs is captured when the committee confirms it, so the record survives
 * everything that happens afterwards: a member leaving the roster, a tournament
 * being renamed, an event deleted under the retention policy, or a scoring
 * correction that would otherwise re-decide a championship years later. A board
 * that changes when you fix a bug is not a board.
 * There is no foreign key to Event for the same reason. `eventId` is kept so a
 * confirmed tournament can be recognised, but the entry does not depend on the
 * row still existing — a club's oldest records are exactly the ones whose
 * events are gone.
 * Unique on (eventId, playerId) rather than on eventId alone: the same player
 * cannot be recorded twice for one tournament, but two CAN share a title. The
 * domain refuses to break a tie precisely so a committee can declare a shared
 * one, and a schema that forbade it would make that refusal a dead end.
 */
model HonoursEntry {
  id             String @id @default(cuid())
  organizationId String

  /**
   * The tournament this was won in. No FK — see the note above.
   */
  eventId   String
  /**
   * What the tournament was called when it was won.
   */
  eventName String
  /**
   * The club's own dates, as written.
   */
  dates     String @default("")
  /**
   * The year the board files it under. 0 when the dates say nothing.
   */
  year      Int    @default(0)

  /**
   * Who won. Kept for linking to a member's history where they still exist.
   */
  playerId     String @default("")
  /**
   * Their name AS CONFIRMED. The board shows this, never a lookup.
   */
  championName String

  /**
   * A committee's own words: a play-off, a shared title, a countback.
   */
  note String @default("")

  /**
   * Says who, and when. A board without that cannot answer a question in ten
   * years' time, which is the only timescale a board is for.
   */
  confirmedBy String   @default("")
  confirmedAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([eventId, playerId])
  @@index([organizationId])
}

/**
 * A club's credentials for one association, one capability.
 *
 * Kept out of Organization on purpose. A club may hold a read permission and
 * not a write one, or have GHIN for handicaps while a second association
 * handles something else later, and a column per capability on Organization
 * would need a schema change every time that grows.
 *
 * `secret` IS A SECRET. It must never reach a client component, never appear
 * in an audit log, and never be selected by a query whose result is rendered.
 * `integration-secrecy.test.ts` enforces that by reading the source, because
 * this is exactly the kind of rule that holds until somebody adds a screen.
 *
 * NOT YET ENCRYPTED AT REST, and nothing real should be put in it until it is.
 * Encryption needs a key that is rotated and stored somewhere other than the
 * database it protects, which is a decision about deployment rather than a
 * line of code here. Recorded rather than quietly deferred.
 */
model Integration {
  id             String @id @default(cuid())
  organizationId String

  /// Which provider — "ghin" today. See lib/integrations/registry.ts.
  providerId String

  /// "handicap" (read indexes) or "scores" (post rounds back).
  capability String

  /// Opaque to this app. A key, a token, an association club number.
  secret String @default("")

  /// Non-secret settings: an association club id, a region code.
  settings String @default("{}")

  /// The last time this app got a straight answer using these credentials.
  verifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// One credential per club per provider per capability.
  @@unique([organizationId, providerId, capability])
  @@index([organizationId])
}

/**
 * One attempt to write one round to one golfer's official record.
 *
 * An outbox, not a log. It exists so that posting a score is IDEMPOTENT: the
 * unique key below is what makes a second attempt impossible at the database
 * rather than at a check somebody has to remember to write. A duplicate post
 * is not a duplicate row — it is a real person's handicap index moving twice
 * on a round they played once, at every club they play, with no undo this app
 * controls.
 *
 * Refusals are recorded rather than swallowed. A club has to be able to see
 * what did not go and why — a player with no association number, a card with
 * holes missing — because the alternative is a committee discovering in
 * October that half a season never reached the association.
 */
model HandicapPost {
  id       String @id @default(cuid())
  eventId  String
  stageId  String
  playerId String

  /// `${eventId}:${stageId}:${playerId}` — see domain/score-posting.ts.
  postKey String

  /// pending | sent | refused | failed
  status String @default("pending")

  /// Which association this went to.
  providerId String @default("ghin")

  /// The association's own id for the posted score, when it accepted one.
  reference String @default("")

  /// Why it did not go, from domain/score-posting.ts. Showable to a club.
  refusal String @default("")
  detail  String @default("")

  attempts  Int       @default(0)
  postedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  /// THE CONSTRAINT THAT MATTERS. One golfer, one round, one post — enforced
  /// here so two requests racing each other cannot both succeed.
  @@unique([postKey])
  @@index([eventId])
  @@index([status])
}
