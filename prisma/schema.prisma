// Prisma schema for the Golf Tournament Organizer.
// Postgres in every environment (dev + prod) — the app code goes through
// the repository in src/lib/db, so no query changes needed either way.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A person's login identity — separate from Account, which is their
// per-event role. One User (one email, one password) can hold an Account
// on any number of events; password auth checks User, access control
// checks Account. An empty password means the identity exists (an
// organizer pre-provisioned this email as a player/staff Account) but
// hasn't been claimed with a password yet.
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String   @default("")
  password  String   @default("")
  createdAt DateTime @default(now())

  resetTokens PasswordResetToken[]
  memberships OrganizationMember[]
}

/**
 * The billing tenant: a golf club, society, or an individual organizer.
 *
 * Tournaments belong to an organization rather than floating free, so a
 * subscription has something to attach to. Everyone gets one — an individual
 * organizer's is `kind = "personal"` — which keeps a single code path instead
 * of "event with an org" and "event without one".
 *
 * Note what is deliberately *not* here: players. They hold per-event Account
 * rows and are never organization members, so seat counts can never be
 * inflated by the field. Charging a club for its staff should never mean
 * charging its golfers.
 */
model Organization {
  id        String   @id @default(cuid())
  name      String
  /** personal | club — a club is a shared tenant with staff; personal is one organizer. */
  kind      String   @default("personal")

  // Branding, applied to the console header and printed output for every
  // tournament this organization owns.
  /** Absolute https:// URL to a logo image. A URL rather than an upload
   *  because file uploads need blob storage; this works with the club's
   *  existing website assets and can be swapped for an upload later without
   *  changing anything that reads it. */
  logoUrl      String @default("")
  /** Optional short name for tight spaces (headers, print). Falls back to `name`. */
  shortName    String @default("")

  // House defaults for new tournaments. Communities often have several
  // organizers who each run their events differently, so these are only a
  // starting point — every tournament keeps its own copy and can diverge.
  defaultLeaderboardVisibility String  @default("participants")
  defaultScoreEntryBy          String  @default("players")
  defaultScoreEntryWindow      String  @default("during")
  defaultVoiceEntry            Boolean @default(true)
  defaultPlayerAccess          String  @default("email")
  defaultScoreApproval         String  @default("staff")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members      OrganizationMember[]
  roster       Member[]
  events       Event[]
  subscription Subscription?
}

/**
 * A person on the club's roster — the primary record of who plays here.
 *
 * Tournaments draw from this rather than each event holding its own island of
 * names. Before this existed, a member who played twelve events was twelve
 * unrelated rows: no history, no single place to correct a phone number, and
 * no way to answer "what has this member played?".
 *
 * Distinct from OrganizationMember, which is *staff* (who can administer the
 * club). A Member is a golfer; they need no login and never take a seat.
 */
model Member {
  id             String @id @default(cuid())
  organizationId String

  name         String
  email        String @default("")
  phone        String @default("")
  ghin         String @default("")
  homeClub     String @default("")
  gender       String @default("")
  preferredTee String @default("")
  /** Club membership number, where the club uses one. */
  memberNumber String @default("")

  /**
   * Current handicap index — the roster's canonical value. Each event entry
   * keeps its own snapshot (Player.handicap), so correcting an index today
   * never rewrites the result of a tournament played last season.
   */
  handicap       Float  @default(0)
  handicapType   String @default("18") // 9 | 18
  handicapSource String @default("manual") // ghin | manual | none

  /** active | inactive — inactive members stay for history but are hidden
   *  from the default roster view and from "add to tournament". */
  status String @default("active")
  notes  String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entries      Player[]

  @@index([organizationId])
  @@index([organizationId, status])
}

/** Staff membership in an organization. Distinct from per-event Account
 *  roles: this is who belongs to the club, not who does what in one event. */
model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  /** owner (billing) | admin (manage events & staff) | member (staff pool) */
  role           String   @default("member")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

/**
 * An organization's plan. Every organization has exactly one, including free
 * ones, so billing code never has to treat "no subscription" as a separate
 * case.
 *
 * What a plan *includes* lives in code (src/lib/plans.ts), not here — tier
 * limits change far more often than schemas should, and a price change
 * shouldn't require a migration and a backfill. Only the plan's name is
 * stored.
 *
 * The provider columns are unused until payments are wired up; they exist so
 * that adding Stripe later is a code change, not a migration against live
 * tenant data.
 */
model Subscription {
  id             String    @id @default(cuid())
  organizationId String    @unique
  /** Key into PLANS in src/lib/plans.ts. */
  plan           String    @default("free")
  /** active | trialing | past_due | canceled */
  status         String    @default("active")
  /** e.g. "stripe" — empty until a payment provider is connected. */
  provider               String  @default("")
  providerCustomerId     String?
  providerSubscriptionId String?
  currentPeriodEnd       DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

/** A one-time, short-lived "forgot password" link. Only the sha256 of the
 *  raw token is stored — the raw value lives solely in the emailed URL, so a
 *  database read alone can never produce a usable reset link. */
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Event {
  id              String   @id @default(cuid())
  /** Owning tenant. Required so no tournament can exist outside a billing
   *  boundary — existing events were backfilled to their organizer's
   *  personal organization. */
  organizationId  String
  name            String
  dates           String
  format          String   @default("match") // match | stroke
  course          String
  city            String
  address         String
  // Set when `course` doesn't match a built-in preset — the organizer's own
  // hole-by-hole data (JSON number[18] each), entered via the course setup
  // prompt on Score entry. Empty until saved.
  customPars        String @default("")
  customYards       String @default("")
  customStrokeIndex String @default("")
  regDeadline     String
  capacity        Int      @default(32)
  playerCountMode String   @default("registration") // registration | manual
  manualPlayerCount Int    @default(32)

  // Flight formation + qualification config
  formationRule   String   @default("balanced") // balanced | handicap | seeding | random | manual
  flightMode      String   @default("auto")     // auto | count | perFlight
  flightValue     Int      @default(0)
  qualifyPerGroup Int      @default(2)
  qualifyMode     String   @default("perFlight") // perFlight | overall
  qualifyOverall  Int      @default(16)

  // Scoring rules (round-robin stages)
  winPts        Float  @default(3)
  tiePts        Float  @default(1)
  lossPts       Float  @default(0)
  holeRatioPts  Float  @default(0.5)
  bonusPts      Float  @default(0)
  tiebreakers   String @default("[\"head-to-head\",\"holes-won-ratio\",\"fewest-holes-lost\",\"lower-handicap\"]")

  inviteMessage String @default("")

  // How players see standings and report scores. Copied from the owning
  // organization's defaults when the tournament is created, then owned
  // outright — changing a house default must never alter the rules of an
  // event already under way. Values and their meanings live in
  // src/lib/tournament-settings.ts.
  leaderboardVisibility String  @default("participants") // staff | participants | public
  scoreEntryBy          String  @default("players")      // staff | players
  scoreEntryWindow      String  @default("during")       // during | after
  voiceEntry            Boolean @default(true)
  playerAccess          String  @default("email")        // email | code | both
  /** Who locks a result: "staff" holds every submitted card for organizer
   *  review; "players" keeps the two-player confirmation with a 24h
   *  auto-confirm. Defaults to staff — auto-confirming an unreviewed score is
   *  not something an organizer should get without asking for it. */
  scoreApproval         String  @default("staff")        // staff | players
  /** Unguessable id for the public read-only leaderboard. Always present, but
   *  the link only resolves while leaderboardVisibility is "public", so
   *  publishing and un-publishing is a single toggle and the URL survives it. */
  shareToken String @unique

  // Lifecycle
  status         String    @default("draft") // draft | registration | ready | live | completed
  configUnlocked Boolean   @default(false)    // organizer override to edit after launch
  launchedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accounts       Account[]
  players        Player[]
  groups         Group[]
  stages         Stage[]
  matches        Match[]
  bracketWinners BracketWinner[]
  commentary     Commentary[]
  scorecards     Scorecard[]
  matchScorecards MatchScorecard[]
  prizes         Prize[]
  announcements  Announcement[]
  auditLogs      AuditLog[]

  @@index([organizationId])
}

model Account {
  id      String @id @default(cuid())
  eventId String
  name    String
  email   String
  role    String @default("player") // admin | player

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, email])
  @@index([eventId])
}

/**
 * One person's entry in one tournament.
 *
 * The identity lives on Member (the club roster); this is the participation:
 * seed, status, flight, and a snapshot of the details as they stood for this
 * event. `handicap` in particular is deliberately a snapshot — correcting a
 * member's index today must not rewrite a tournament played last season.
 */
model Player {
  id       String @id @default(cuid())
  eventId  String
  /** Roster record this entry belongs to. Optional only so that entries made
   *  before the roster existed remain valid; every path that creates a player
   *  now goes through a Member. */
  memberId String?
  name     String
  handicap Float  @default(0)
  seed     Int
  status   String @default("confirmed") // confirmed | waitlisted | withdrawn

  // Registration details
  email          String @default("")
  phone          String @default("")
  ghin           String @default("")
  homeClub       String @default("")
  gender         String @default("")
  preferredTee   String @default("")
  handicapSource String @default("manual") // ghin | manual | none
  handicapType   String @default("18") // 9 | 18 — which index this handicap number represents

  groupId  String?

  event  Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  group  Group?  @relation(fields: [groupId], references: [id], onDelete: SetNull)
  // Removing someone from the roster must not delete tournaments they played
  // in — the entry stays, detached, preserving the result.
  member Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([groupId])
  @@index([memberId])
}

model Group {
  id       String @id @default(cuid())
  eventId  String
  name     String
  position Int

  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  players Player[]
  matches Match[]

  @@index([eventId])
}

model Stage {
  id                  String  @id @default(cuid())
  eventId             String
  position            Int
  type                String // Round Robin | Qualification Stage | Single Match Stage | Bracket Stage
  description         String  @default("")
  format              String  @default("Match Play") // golf format (see src/lib/formats.ts)
  holes               Int     @default(18)           // 9 | 18
  deadline            String  @default("")
  scoringBasis        String  @default("gross") // gross | net | both
  carryForwardEnabled Boolean @default(false)
  carryForwardPct     Int     @default(0)

  // Field cut entering this round (Round Robin stages after the first): only
  // the top cutCount / cutPercent players from the previous round's standings
  // are scheduled here. Generated separately from the global flight builder
  // via generateNextRound, since it depends on that round's real results.
  cutEnabled Boolean @default(false)
  cutMode    String  @default("count") // count | percent
  cutCount   Int     @default(16)
  cutPercent Int     @default(50)

  /**
   * Round Code — the shared code players enter to report scores for this
   * round, modelled on the GGID golfers already know from Golf Genius.
   *
   * Per round rather than per player because distribution is the problem that
   * decides whether self-scoring gets used at all: one code read out on the
   * first tee beats forty printed slips. A twelve-round league has twelve
   * codes, and last week's stops working.
   *
   * The trade is real and deliberate: a shared code proves membership of the
   * round, not identity, so the player picks their own name after entering it.
   * Empty unless the tournament has code access switched on.
   */
  accessCode String @default("")

  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  matches Match[]

  @@index([eventId])
  // Redemption looks a code up on its own, so codes must be unique across
  // every tournament. Enforced by a *partial* unique index in the migration
  // (unique where accessCode <> ''), which Prisma's schema language can't
  // express — a plain @@unique would make the empty default collide for every
  // round that has no code.
}

model Match {
  id        String @id @default(cuid())
  eventId   String
  stageId   String
  groupId   String
  round     Int
  playerAId String
  playerBId String
  // JSON array of 'A' | 'B' | 'H' | null, one per hole.
  holes     String @default("[]")

  // Score confirmation (two-player workflow)
  scoreStatus   String    @default("pending") // pending | confirmed | disputed
  scoredAt      DateTime?
  confirmedById String?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  stage Stage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  matchScorecards MatchScorecard[]

  @@index([eventId])
  @@index([stageId])
  @@index([groupId])
}

model AuditLog {
  id        String   @id @default(cuid())
  eventId   String
  matchId   String?
  actor     String   @default("")
  action    String
  detail    String   @default("")
  createdAt DateTime @default(now())

  // Cascade like every other per-event table. Without this relation the rows
  // survived their tournament being deleted, leaving orphaned records that
  // still named the people involved (`actor`) — deleting a tournament must
  // purge everything belonging to it.
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model BracketWinner {
  id       String @id @default(cuid())
  eventId  String
  // Key: "{winners|consolation}-{roundIndex}-{matchIndex}"
  key      String
  winnerId String
  result   String @default("") // recorded match result, e.g. "3&2"

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, key])
  @@index([eventId])
}

model Commentary {
  id        String   @id @default(cuid())
  eventId   String
  author    String   @default("")
  text      String
  source    String   @default("organizer") // organizer | ai
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

/** A prize / payout line — flight winner, skin, closest-to-pin, etc. */
model Prize {
  id       String  @id @default(cuid())
  eventId  String
  position Int     @default(0)
  category String // e.g. "Flight 1 — Winner", "Skins", "Closest to Pin (Hole 7)"
  detail   String  @default("")
  amount   Float   @default(0)
  winnerId String? // optional Player id once awarded

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

/** An announcement pushed to players (schedule change, notice, results). */
model Announcement {
  id        String   @id @default(cuid())
  eventId   String
  title     String
  body      String   @default("")
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

/** Individual stroke-play scorecard for a player in a round. */
model Scorecard {
  id       String @id @default(cuid())
  eventId  String
  stageId  String
  playerId String
  // JSON array of per-hole gross strokes (number | null), one per hole.
  strokes  String @default("[]")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([stageId, playerId])
  @@index([eventId])
}

/**
 * One side's gross-strokes card for a single match-play match (net or gross
 * "Scorecard" entry mode). Deliberately separate from Scorecard above: that
 * model is keyed by (stage, player) for standalone Stroke Play rounds, and a
 * player can also be a match-play participant in the same stage — keying
 * this one by (match, slot) instead avoids the two features colliding on
 * the same row.
 */
model MatchScorecard {
  id      String @id @default(cuid())
  eventId String
  matchId String
  slot    String // "A" | "B"
  // JSON array of per-hole gross strokes (number | null), one per hole.
  strokes String @default("[]")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, slot])
  @@index([eventId])
}
